<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Treat compiler/analyzer warnings as errors repo-wide (ADR "Enforce TreatWarningsAsErrors"): a build is
         not done while it leaves a warning. NuGet package-audit warnings (NU1901 through NU1904,
         deprecated/vulnerable) are deliberately excluded because the dedicated CI vulnerable-dependency scan
         (ADR 0379) owns vulnerability-blocking, so a freshly-published advisory cannot break every local and CI
         compile mid-task. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <!-- The product's name as a build ships it (core #1117; trademark applied for 2026-10-26): ONE value. A white-label
       build overrides it (dotnet publish -p:ProductName=...). SimplArchive.Localization compiles it into
       Strings.DefaultProductName; an installation may still name itself through Branding:ProductName. Identifiers
       (namespaces, package ids, the media type) do not follow it. -->
  <PropertyGroup>
    <ProductName>Alcifra</ProductName>
  </PropertyGroup>
</Project>
