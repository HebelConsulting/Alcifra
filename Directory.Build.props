<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Treat compiler/analyzer warnings as errors repo-wide (ADR "Enforce TreatWarningsAsErrors"): a build is
         not done while it leaves a warning. NuGet package-audit warnings (NU1901 through NU1904,
         deprecated/vulnerable) are deliberately excluded because the dedicated CI vulnerable-dependency scan
         (ADR 0379) owns vulnerability-blocking, so a freshly-published advisory cannot break every local and CI
         compile mid-task. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <!-- The product's name as a build ships it (core #1117): ONE value, read from the brand file brand/brand.json (ADR 0989),
       which a white-label build replaces. A command line may still override it (dotnet publish -p:ProductName=...).
       SimplArchive.Localization compiles it into Strings.DefaultProductName; an installation may still name itself
       through Branding:ProductName. Wire names never follow it (ADR 0987). The restore layer of the Dockerfile has
       neither this file nor the brand, which is why the read is guarded by Exists. -->
  <PropertyGroup>
    <BrandFile>$(MSBuildThisFileDirectory)brand/brand.json</BrandFile>
    <ProductName Condition="'$(ProductName)' == '' And Exists('$(BrandFile)')">$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(BrandFile)')), '(?s)^.*?&quot;name&quot;\s*:\s*&quot;([^&quot;]*)&quot;.*$', '$1'))</ProductName>
  </PropertyGroup>
  <!-- The brand's icons (ADR 0993): generated at build time by src/SimplArchive.BrandIcons into BrandIconsDir, never
       committed. A project that uses them sets UsesBrandIcons; Directory.Build.targets builds and runs the generator
       first. A build that cannot run it (the Alpine image stages) passes GenerateBrandIcons=false and a BrandIconsDir
       made elsewhere. -->
  <PropertyGroup>
    <BrandAssetsDir>$(MSBuildThisFileDirectory)brand/assets/</BrandAssetsDir>
    <BrandIconsDir Condition="'$(BrandIconsDir)' == ''">$(MSBuildThisFileDirectory)artifacts/brand-icons/</BrandIconsDir>
    <BrandIconsProject>$(MSBuildThisFileDirectory)src/SimplArchive.BrandIcons/SimplArchive.BrandIcons.csproj</BrandIconsProject>
  </PropertyGroup>
</Project>
