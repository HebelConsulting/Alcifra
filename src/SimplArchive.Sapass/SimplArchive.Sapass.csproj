<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>sapass</AssemblyName>
    <RootNamespace>SimplArchive.Sapass</RootNamespace>
    <!-- A CLI installed from the feed, like saconsole: it talks to the Api over HTTP and references no application
         project. Its key path is the shared HardwareKeys leaf, so the desktop and this tool open the same envelopes
         through ONE implementation (C_Initialize is per process, ADR 0832). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sapass</ToolCommandName>
    <PackageId>SimplArchive.Sapass</PackageId>
    <Description>sapass — a pass-like store of passwords and secrets, sealed on your machine and opened only with your hardware key: list, search and read entries from the terminal.</Description>
    <PackageProjectUrl>https://github.com/HebelConsulting/SimplArchive</PackageProjectUrl>
    <RepositoryUrl>https://github.com/HebelConsulting/SimplArchive.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SimplArchive.ApiClient/SimplArchive.ApiClient.csproj" />
    <ProjectReference Include="../SimplArchive.BrowserHost/SimplArchive.BrowserHost.csproj" />
    <ProjectReference Include="../SimplArchive.ConsoleLogging/SimplArchive.ConsoleLogging.csproj" />
    <ProjectReference Include="../SimplArchive.HardwareKeys/SimplArchive.HardwareKeys.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tree's path building and the completion candidates are pure functions worth asserting directly; the
         types themselves stay internal to the tool. -->
    <InternalsVisibleTo Include="SimplArchive.UnitTests" />
    <InternalsVisibleTo Include="SimplArchive.EndToEndTests" />
  </ItemGroup>

</Project>
