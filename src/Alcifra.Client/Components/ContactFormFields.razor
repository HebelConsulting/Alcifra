@using Alcifra.Client.Services

@* A contact's structured fields (#631), one component for the editor dialog and the preview's card (#2215): the same form
   in two postures, so they cannot come to disagree. Where the card shows it, CanEdit is false: the fields are read-only
   and nothing is added or removed; the card's pencil opens the dialog. The desktop's ContactForm is its twin. *@
<div class="d-flex" style="gap:8px;">
    <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="Form.GivenName" Label="@Strings.Get("ContactGivenName")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
    <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="Form.FamilyName" Label="@Strings.Get("ContactFamilyName")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
</div>
<div class="d-flex mt-2" style="gap:8px;">
    <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="Form.Organization" Label="@Strings.Get("ContactsOrg")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
    <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="Form.Title" Label="@Strings.Get("ContactJobTitle")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
</div>

@* Each repeatable group carries its Add button in its own heading row, so the affordance sits with
   the thing it adds to rather than at the far end of the form (ADR 0550). *@
<RepeatableFieldGroup Title="@Strings.Get("ContactsEmail")" Rows="Form.Emails" CanEdit="Form.StructuredEnabled"
                      DefaultType="work" Placeholder="name@example.com" />
<RepeatableFieldGroup Title="@Strings.Get("ContactsPhone")" Rows="Form.Phones" CanEdit="Form.StructuredEnabled"
                      DefaultType="mobile" />

<div class="d-flex align-center justify-space-between mt-4 mb-1">
    <MudText Typo="Typo.subtitle2">@Strings.Get("ContactAddress")</MudText>
    <MudIconButton Icon="@Icons.Material.Filled.Add" Class="@(Form.CanEdit ? null : "d-none")" Size="Size.Small" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)"
                   OnClick="@(() => Form.Addresses.Add(new ContactAddressRow()))"
                   title="@Strings.Get("ContactAddAddress")" aria-label="@Strings.Get("ContactAddAddress")" />
</div>
@foreach (var address in Form.Addresses.ToList())
{
    <MudPaper Outlined="true" Class="pa-2 mb-2">
        <div class="d-flex align-center" style="gap:8px;">
            <MudSelect T="string" @bind-Value="address.Type" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Style="max-width:110px;" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)">
                @foreach (var type in ContactAddressRow.Types)
                {
                    <MudSelectItem T="string" Value="type">@type</MudSelectItem>
                }
            </MudSelect>
            <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="address.Street" Placeholder="@Strings.Get("ContactStreet")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Class="@(Form.CanEdit ? null : "d-none")" Size="Size.Small" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)"
                           OnClick="@(() => Form.Addresses.Remove(address))"
                           title="@Strings.Get("Remove")" aria-label="@Strings.Get("Remove")" />
        </div>
        <div class="d-flex mt-2" style="gap:8px;">
            <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="address.City" Placeholder="@Strings.Get("ContactCity")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
            <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="address.PostalCode" Placeholder="@Strings.Get("ContactPostalCode")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:130px;"
                          Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
        </div>
        <div class="d-flex mt-2" style="gap:8px;">
            <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="address.Region" Placeholder="@Strings.Get("ContactRegion")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
            <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="address.Country" Placeholder="@Strings.Get("ContactCountry")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
        </div>
    </MudPaper>
}

<div class="d-flex mt-3" style="gap:8px;">
    <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="Form.Birthday" Label="@Strings.Get("ContactBirthday")" Placeholder="1990-02-15"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
    <MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="Form.Url" Label="@Strings.Get("ContactUrl")"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />
</div>
<MudTextField ReadOnly="@(!Form.CanEdit)" @bind-Value="Form.Note" Label="@Strings.Get("ContactNote")" Lines="3" Class="mt-2"
              Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Form.CanEdit && !Form.StructuredEnabled)" />

@* Says plainly that the rest of the card is safe. Without it, a user who knows their contact has a
   photo has no reason to believe this form kept it. *@
@if (Form.CanEdit)
{
    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-3">
        @Strings.Get("ContactPreservedNote")
    </MudText>
}

@code {
    /// <summary>The card being shown or edited.</summary>
    [Parameter, EditorRequired] public ContactCardForm Form { get; set; } = null!;
}
