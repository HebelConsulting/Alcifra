@* Enrols a device or changes an enrolled one (#1970 slice 3): name, what it reaches, mail encryption with the known
   client limitation beside it. Locked on where the organisation seals mail. Returns the request; the caller acts. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 380px;">
            <MudTextField T="string" @bind-Value="_name" Label="@Strings.Get("DvName")" Placeholder="@Strings.Get("DvNameHint")"
                          MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudText Typo="Typo.subtitle2" Class="mt-3">@Strings.Get("DvColReaches")</MudText>
            <MudCheckBox T="bool" @bind-Value="_mail" Label="@Strings.Get("DvMail")" Dense="true" />
            <MudCheckBox T="bool" @bind-Value="_files" Label="@Strings.Get("DvFiles")" Dense="true" />
            <MudCheckBox T="bool" @bind-Value="_calendars" Label="@Strings.Get("DvCalendars")" Dense="true" />
            <MudCheckBox T="bool" @bind-Value="_contacts" Label="@Strings.Get("DvContacts")" Dense="true" />
            <MudCheckBox T="bool" @bind-Value="_encrypt" Label="@Strings.Get("DvEncryptMail")" Dense="true" Disabled="EncryptLocked" Class="mt-2" />
            @if (EncryptLocked)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@Strings.Get("DvEncryptLocked")</MudText>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@Strings.Get("DvEncryptHint")</MudText>
            @if (_choices is not null)
            {
                @* Calendars and contacts (#2090): all, or the user's own plus the ticked shared ones — what an iPhone or iPad shows. *@
                <MudText Typo="Typo.subtitle2" Class="mt-3">@Strings.Get("DvCollections")</MudText>
                <MudRadioGroup T="bool" @bind-Value="_chosen" data-testid="device-collections">
                    <MudRadio T="bool" Value="false" Dense="true">@Strings.Get("DvCollectionsAll")</MudRadio>
                    <MudRadio T="bool" Value="true" Dense="true">@Strings.Get("DvCollectionsChosen")</MudRadio>
                </MudRadioGroup>
                @if (_chosen)
                {
                    <div class="ml-6" style="max-height: 180px; overflow-y: auto;">
                        @foreach (var choice in _choices)
                        {
                            <MudCheckBox T="bool" Value="_ticked.Contains(choice.Id)" ValueChanged="on => Tick(choice.Id, on)" Dense="true"
                                         Label="@($"{Strings.Get(choice.Kind == "calendar" ? "DvCalendars" : "DvContacts")}: {choice.Name}")" />
                        }
                        @if (_choices.Count == 0)
                        {
                            <MudText Typo="Typo.caption">@Strings.Get("DvCollectionsNone")</MudText>
                        }
                    </div>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">@Strings.Get("DvCollectionsHint")</MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">@Strings.Get("Cancel")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="string.IsNullOrWhiteSpace(_name)">@Strings.Get("Save")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>The device to change, or null to enrol a new one.</summary>
    [Parameter]
    public Alcifra.Client.Services.DevicesApi.DeviceDto? Device { get; set; }

    [Parameter]
    public bool EncryptLocked { get; set; }

    private string _name = string.Empty;
    private bool _mail = true;
    private bool _files = true;
    private bool _calendars = true;
    private bool _contacts = true;
    private bool _encrypt;
    private bool _chosen;
    private List<Alcifra.Client.Services.DevicesApi.CollectionDto>? _choices;
    private readonly HashSet<Guid> _ticked = [];

    [Inject]
    private Alcifra.Client.Services.DevicesApi DevicesApi { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        OnInitializedFields();
        if (Device is { CollectionsHref: not null } device)
        {
            _chosen = device.CollectionsChosen;
            _choices = await DevicesApi.CollectionsAsync(device);
            _ticked.UnionWith(_choices.Where(c => c.Ticked).Select(c => c.Id));
        }
    }

    private void Tick(Guid id, bool on)
    {
        if (on)
        {
            _ticked.Add(id);
        }
        else
        {
            _ticked.Remove(id);
        }
    }

    private void OnInitializedFields()
    {
        if (Device is { } device)
        {
            (_name, _mail, _files, _calendars, _contacts, _encrypt) =
                (device.Name, device.Mail, device.Files, device.Calendars, device.Contacts, device.EncryptMail);
        }

        if (EncryptLocked)
        {
            _encrypt = true;
        }
    }

    // The collections are stated once their choices were read; until then, as stored.
    private void Save() => Dialog.Close(DialogResult.Ok(new Alcifra.Client.Services.DevicesApi.DeviceRequest(
        _name.Trim(), _mail, _files, _calendars, _contacts, _encrypt && !EncryptLocked,
        _choices is null ? Device?.CollectionsChosen : _chosen,
        _choices is null ? Device?.ChosenCollections : [.. _ticked])));
}
