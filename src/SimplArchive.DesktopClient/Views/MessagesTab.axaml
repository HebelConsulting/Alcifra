<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             x:Class="SimplArchive.DesktopClient.Views.MessagesTab"
             x:DataType="vm:MessagesTabViewModel">

  <UserControl.Styles>
    <!-- A bubble: mine on the right in the accent's tint, others on the left; drawn from the Messenger's display
         rules, so it reads as on the phone. -->
    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{DynamicResource WbChrome}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="MaxWidth" Value="560" />
    </Style>
    <Style Selector="Border.bubble.mine">
      <Setter Property="Background" Value="{DynamicResource WbAccentTint}" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.placeholder">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Foreground" Value="{DynamicResource WbMuted}" />
    </Style>
  </UserControl.Styles>

  <!-- The Messages tab (core #1813): conversations │ thread. Read here; writing and replying stay on the phone. -->
  <DockPanel LastChildFill="True" Margin="8">

    <Border DockPanel.Dock="Top" Classes="ribbon">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Command="{Binding LoadCommand}" ToolTip.Tip="{loc:Tr RibbonRefresh}" AutomationProperties.Name="{loc:Tr RibbonRefresh}">
          <i:Icon Value="mdi-refresh" FontSize="18" />
        </Button>
        <Border Width="1" Background="{DynamicResource WbBorder}" Margin="4,2" />
        <!-- Back up and Restore: sealed files, nothing decrypted; the same library as the phone and saconsole. -->
        <Button Command="{Binding BackUpCommand}" ToolTip.Tip="{loc:Tr MsgBackUpToFile}" AutomationProperties.Name="{loc:Tr MsgBackUpToFile}">
          <i:Icon Value="mdi-content-save-outline" FontSize="18" />
        </Button>
        <Button Command="{Binding RestoreCommand}" ToolTip.Tip="{loc:Tr MobBackupRestore}" AutomationProperties.Name="{loc:Tr MobBackupRestore}">
          <i:Icon Value="mdi-backup-restore" FontSize="18" />
        </Button>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="260,4,*">

      <DockPanel Grid.Column="0" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyMessage}" Foreground="{DynamicResource WbMuted}"
                   TextWrapping="Wrap" Margin="2,4,0,0" IsVisible="{Binding EmptyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <ListBox ItemsSource="{Binding Conversations}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MessagesConversationViewModel">
              <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Foreground="{DynamicResource WbMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource WbBorder}" />

      <DockPanel Grid.Column="2" LastChildFill="True" Margin="8,0,0,0">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ThreadNote}" Foreground="{DynamicResource WbMuted}"
                   HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" />
        <ScrollViewer x:Name="Thread">
          <ItemsControl ItemsSource="{Binding Bubbles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageBubbleViewModel">
                <StackPanel>
                  <Border Classes="bubble" Classes.mine="{Binding IsMine}">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" Foreground="{DynamicResource WbAccentText}" IsVisible="{Binding HasSender}" />
                      <Border Background="{DynamicResource WbBorder}" CornerRadius="6" Padding="8,4" IsVisible="{Binding HasQuote}">
                        <TextBlock Text="{Binding Quote}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource WbMuted}" />
                      </Border>
                      <!-- A photo or file: opened in its own application, decrypted here with the reader's key. -->
                      <Button Content="{Binding FileName}" IsVisible="{Binding HasFile}" Classes="link"
                              Command="{Binding $parent[ItemsControl].((vm:MessagesTabViewModel)DataContext).OpenFileCommand}"
                              CommandParameter="{Binding}" />
                      <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding HasText}" Classes.placeholder="{Binding IsPlaceholder}" />
                      <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="{DynamicResource WbMuted}" HorizontalAlignment="Right" />
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{Binding Receipt}" FontSize="11" Foreground="{DynamicResource WbMuted}" HorizontalAlignment="Right"
                             IsVisible="{Binding HasReceipt}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
