<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             xmlns:v="using:SimplArchive.DesktopClient.Views"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             x:Class="SimplArchive.DesktopClient.Views.PasswordsTab"
             x:DataType="vm:PasswordsTabViewModel">

  <UserControl.Styles>
    <Style Selector="Border.paneHeader">
      <Setter Property="BorderBrush" Value="{DynamicResource WbBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0,0,0,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{DynamicResource WbSurface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource WbBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="Border.notice.urgent">
      <Setter Property="BorderBrush" Value="{DynamicResource WbDanger}" />
    </Style>
  </UserControl.Styles>

  <!-- The Passwords tab (ADR 0968): stores and folders │ a folder's folders and entries │ the opened entry in the preview
       pane, or the form while editing. The ribbon acts on the tab (icons, the label on hover, ADR 0873). -->
  <DockPanel LastChildFill="True" Margin="8">

    <Border DockPanel.Dock="Top" Classes="ribbon">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Command="{Binding LoadCommand}" ToolTip.Tip="{loc:Tr RibbonRefresh}" AutomationProperties.Name="{loc:Tr RibbonRefresh}">
          <i:Icon Value="mdi-refresh" FontSize="18" />
        </Button>
        <Border Width="1" Background="{DynamicResource WbBorder}" Margin="4,2" />
        <Button Command="{Binding NewEntryCommand}" IsEnabled="{Binding CanCreate}" ToolTip.Tip="{loc:Tr PwNewEntry}" AutomationProperties.Name="{loc:Tr PwNewEntry}">
          <i:Icon Value="mdi-key-plus" FontSize="18" />
        </Button>
        <Button Command="{Binding NewFolderCommand}" IsEnabled="{Binding CanCreate}" ToolTip.Tip="{loc:Tr PwNewFolder}" AutomationProperties.Name="{loc:Tr PwNewFolder}">
          <i:Icon Value="mdi-folder-plus-outline" FontSize="18" />
        </Button>
        <Button Command="{Binding ImportCommand}" IsEnabled="{Binding CanCreate}" ToolTip.Tip="{loc:Tr PwImportGoogle}" AutomationProperties.Name="{loc:Tr PwImportGoogle}">
          <i:Icon Value="mdi-file-import-outline" FontSize="18" />
        </Button>
        <Border Width="1" Background="{DynamicResource WbBorder}" Margin="4,2" />
        <Button Command="{Binding RenameCommand}" IsEnabled="{Binding SelectedItem.Item.CanRename, FallbackValue=False}" ToolTip.Tip="{loc:Tr RibbonRename}" AutomationProperties.Name="{loc:Tr RibbonRename}">
          <i:Icon Value="mdi-rename-box" FontSize="18" />
        </Button>
        <Button Command="{Binding MoveCommand}" IsEnabled="{Binding SelectedItem.Item.CanMove, FallbackValue=False}" ToolTip.Tip="{loc:Tr PwMove}" AutomationProperties.Name="{loc:Tr PwMove}">
          <i:Icon Value="mdi-folder-move-outline" FontSize="18" />
        </Button>
        <Button Command="{Binding DeleteCommand}" IsEnabled="{Binding SelectedItem.Item.CanDelete, FallbackValue=False}" ToolTip.Tip="{loc:Tr RibbonDelete}" AutomationProperties.Name="{loc:Tr RibbonDelete}">
          <i:Icon Value="mdi-delete-outline" FontSize="18" />
        </Button>
        <Border Width="1" Background="{DynamicResource WbBorder}" Margin="4,2" IsVisible="{Binding CanReseal}" />
        <Button Command="{Binding ResealCommand}" IsVisible="{Binding CanReseal}" ToolTip.Tip="{loc:Tr PwReseal}" AutomationProperties.Name="{loc:Tr PwReseal}">
          <i:Icon Value="mdi-lock-reset" FontSize="18" />
        </Button>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="240,4,280,4,*" Margin="0,8,0,0">

      <!-- Stores, My Passwords first, and their folders. -->
      <DockPanel Grid.Column="0" LastChildFill="True">
        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyMessage}" Foreground="{DynamicResource WbMuted}" TextWrapping="Wrap"
                   IsVisible="{Binding EmptyMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TreeView x:Name="StoreTree" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}" Background="Transparent">
          <TreeView.ItemContainerTheme>
            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="vm:PasswordNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </ControlTheme>
          </TreeView.ItemContainerTheme>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:PasswordNodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <i:Icon Value="{Binding Icon}" FontSize="16" Foreground="{DynamicResource WbFolder}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource WbBorder}" />

      <!-- The folder's notices (re-seal, spare key, nothing to seal to), then its folders and entries. -->
      <DockPanel Grid.Column="2" LastChildFill="True" Margin="6,0">
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Notices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PasswordNoticeViewModel">
              <Border Classes="notice" Classes.urgent="{Binding Urgent}">
                <StackPanel Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <i:Icon Value="{Binding Icon}" FontSize="16" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="220" />
                  </StackPanel>
                  <Button Content="{Binding ActionLabel}" IsVisible="{Binding HasAction}" HorizontalAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:PasswordsTabViewModel)DataContext).NoticeActionCommand}" CommandParameter="{Binding}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ListBox x:Name="ItemList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PasswordItemRowViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <i:Icon Value="{Binding Icon}" FontSize="16" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource WbBorder}" />

      <!-- The entry: its name with Edit beside it (Save and Cancel in the same slot while editing, ADR 0550), then the
           preview pane showing it, or the form. -->
      <DockPanel Grid.Column="4" LastChildFill="True" Margin="8,0,0,0">
        <Border DockPanel.Dock="Top" Classes="paneHeader" IsVisible="{Binding SelectedEntryName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
              <Button Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" ToolTip.Tip="{loc:Tr Edit}" AutomationProperties.Name="{loc:Tr Edit}">
                <i:Icon Value="mdi-pencil-outline" FontSize="18" />
              </Button>
              <Button Command="{Binding OpenWithKeyCommand}" IsVisible="{Binding CanOpenWithKey}" Content="{loc:Tr PwOpenWithKey}" />
              <Button Command="{Binding Editor.SaveCommand, FallbackValue={x:Null}}" IsVisible="{Binding IsEditing}"
                      ToolTip.Tip="{loc:Tr PwSaveShortcut}" Content="{loc:Tr Save}" />
              <Button Command="{Binding Editor.CancelCommand, FallbackValue={x:Null}}" IsVisible="{Binding IsEditing}"
                      ToolTip.Tip="{loc:Tr PwCancelShortcut}" Content="{loc:Tr Cancel}" />
            </StackPanel>
            <TextBlock Text="{Binding SelectedEntryName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <Panel>
          <v:PreviewPane DataContext="{Binding Preview}" IsVisible="{Binding !$parent[UserControl].((vm:PasswordsTabViewModel)DataContext).IsEditing}" />
          <v:PasswordEditForm DataContext="{Binding Editor}" IsVisible="{Binding $parent[UserControl].((vm:PasswordsTabViewModel)DataContext).IsEditing}" />
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
