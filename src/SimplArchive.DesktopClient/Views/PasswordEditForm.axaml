<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:SimplArchive.DesktopClient.Localization"
             xmlns:v="using:SimplArchive.DesktopClient.Views"
             xmlns:vm="using:SimplArchive.DesktopClient.ViewModels"
             x:Class="SimplArchive.DesktopClient.Views.PasswordEditForm"
             x:DataType="vm:PasswordEntryEditorViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource WbMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </UserControl.Styles>

  <!-- The create and edit form (ADR 0968, the core's PasswordEntryForm): name on create, then URL, user name and password
       always, the PIN once added, every other field, the notes. Each secret box shows its value only while its eye is held.
       Save (Cmd/Ctrl+S) and Cancel (Esc) sit where Edit was. -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="4,4,12,12" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">

      <Border IsVisible="{Binding HasProblem}" BorderBrush="{DynamicResource WbDanger}" BorderThickness="1" CornerRadius="4" Padding="8,6">
        <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
      </Border>

      <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Grid.Row="0" Classes="label" Text="{loc:Tr Name}" IsVisible="{Binding IsCreating}" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Text="{Binding Name}" IsVisible="{Binding IsCreating}" />

        <TextBlock Grid.Row="1" Classes="label" Text="{loc:Tr PwUrl}" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Url}" />

        <TextBlock Grid.Row="2" Classes="label" Text="{loc:Tr PwUserName}" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UserName}" />

        <TextBlock Grid.Row="3" Classes="label" Text="{loc:Tr PwPassword}" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Password}" PasswordChar="{Binding PasswordReveal.PasswordChar}" FontFamily="Menlo,Consolas,monospace" />
        <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
          <Button v:HoldToReveal.Target="{Binding PasswordReveal}" Padding="6,4" ToolTip.Tip="{loc:Tr PwHoldToShow}" AutomationProperties.Name="{loc:Tr PwHoldToShow}">
            <i:Icon Value="{Binding PasswordReveal.EyeIcon}" FontSize="16" />
          </Button>
          <Button Command="{Binding ToggleGeneratorCommand}" Padding="6,4" ToolTip.Tip="{loc:Tr PwGenerate}" AutomationProperties.Name="{loc:Tr PwGenerate}">
            <i:Icon Value="mdi-dice-multiple-outline" FontSize="16" />
          </Button>
        </StackPanel>

        <TextBlock Grid.Row="4" Classes="label" Text="{loc:Tr MobKeyPin}" IsVisible="{Binding HasPin}" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Pin}" IsVisible="{Binding HasPin}" PasswordChar="{Binding PinReveal.PasswordChar}" FontFamily="Menlo,Consolas,monospace" />
        <Button Grid.Row="4" Grid.Column="2" IsVisible="{Binding HasPin}" Margin="6,0,0,0" v:HoldToReveal.Target="{Binding PinReveal}" Padding="6,4"
                ToolTip.Tip="{loc:Tr PwHoldToShow}" AutomationProperties.Name="{loc:Tr PwHoldToShow}">
          <i:Icon Value="{Binding PinReveal.EyeIcon}" FontSize="16" />
        </Button>
      </Grid>

      <!-- The generator, opened by the dice beside the password: a TYPED length, the classes, look-alikes avoided. -->
      <Panel IsVisible="{Binding GeneratorOpen}">
      <Border DataContext="{Binding Generator}" x:DataType="vm:PasswordGeneratorViewModel"
              BorderBrush="{DynamicResource WbBorder}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="150,0,0,0">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{loc:Tr PwGenerateLength}" VerticalAlignment="Center" />
            <TextBox Text="{Binding Length}" Width="70" />
          </StackPanel>
          <WrapPanel ItemSpacing="12">
            <CheckBox IsChecked="{Binding Lowercase}" Content="{loc:Tr PwGenerateLower}" />
            <CheckBox IsChecked="{Binding Uppercase}" Content="{loc:Tr PwGenerateUpper}" />
            <CheckBox IsChecked="{Binding Digits}" Content="{loc:Tr PwGenerateDigits}" />
            <CheckBox IsChecked="{Binding Symbols}" Content="{loc:Tr PwGenerateSymbols}" />
          </WrapPanel>
          <CheckBox IsChecked="{Binding AvoidAmbiguous}" Content="{loc:Tr PwGenerateAvoidAmbiguous}" />
          <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WbDanger}" IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          <Button Command="{Binding GenerateCommand}" Content="{loc:Tr PwGenerate}" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding HasGenerated}">
            <TextBox Text="{Binding Generated}" IsReadOnly="True" PasswordChar="{Binding Reveal.PasswordChar}" FontFamily="Menlo,Consolas,monospace" />
            <Button Grid.Column="1" v:HoldToReveal.Target="{Binding Reveal}" Padding="6,4"
                    ToolTip.Tip="{loc:Tr PwHoldToShow}" AutomationProperties.Name="{loc:Tr PwHoldToShow}">
              <i:Icon Value="{Binding Reveal.EyeIcon}" FontSize="16" />
            </Button>
            <Button Grid.Column="2" Command="{Binding UseCommand}" Content="{loc:Tr PwUse}" />
          </Grid>
        </StackPanel>
      </Border>
      </Panel>

      <!-- Every other field, in the entry's own order: name, value, hidden like a password or not. -->
      <ItemsControl ItemsSource="{Binding Fields}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PasswordFormFieldViewModel">
            <Grid ColumnDefinitions="150,*,Auto" Margin="0,0,0,8">
              <TextBox Grid.Column="0" Text="{Binding Name}" Watermark="{loc:Tr PwFieldName}" Margin="0,0,12,0" />
              <TextBox Grid.Column="1" Text="{Binding Value}" PasswordChar="{Binding Reveal.PasswordChar}" IsVisible="{Binding IsSecret}" />
              <TextBox Grid.Column="1" Text="{Binding Value}" IsVisible="{Binding !IsSecret}" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0">
                <Button IsVisible="{Binding IsSecret}" v:HoldToReveal.Target="{Binding Reveal}" Padding="6,4"
                        ToolTip.Tip="{loc:Tr PwHoldToShow}" AutomationProperties.Name="{loc:Tr PwHoldToShow}">
                  <i:Icon Value="{Binding Reveal.EyeIcon}" FontSize="16" />
                </Button>
                <ToggleButton IsChecked="{Binding IsSecret}" Padding="6,4" ToolTip.Tip="{loc:Tr PwMarkSecret}" AutomationProperties.Name="{loc:Tr PwMarkSecret}">
                  <i:Icon Value="mdi-shield-key-outline" FontSize="16" />
                </ToggleButton>
                <Button Command="{Binding RemoveCommand}" Padding="6,4" ToolTip.Tip="{loc:Tr PwRemoveField}" AutomationProperties.Name="{loc:Tr PwRemoveField}">
                  <i:Icon Value="mdi-close" FontSize="16" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- "Add field": the PIN first while the entry has none, then a field of the user's naming (owner, 2026-10-23). -->
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="150,0,0,0">
        <TextBlock Text="{loc:Tr PwAddField}" VerticalAlignment="Center" Foreground="{DynamicResource WbMuted}" />
        <Button Command="{Binding AddPinCommand}" IsVisible="{Binding SuggestsPin}" Content="{loc:Tr MobKeyPin}" />
        <Button Command="{Binding AddFieldCommand}" Content="{loc:Tr PwOtherField}" />
      </StackPanel>

      <Grid ColumnDefinitions="150,*">
        <TextBlock Classes="label" Text="{loc:Tr PwNotes}" VerticalAlignment="Top" Margin="0,6,12,0" />
        <TextBox Grid.Column="1" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
