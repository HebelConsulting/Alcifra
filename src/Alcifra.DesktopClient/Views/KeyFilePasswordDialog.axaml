<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.KeyFilePasswordDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <!-- The password of a key file picked to try on a sealed file (#2291). Used once to load the key and dropped. -->
    <StackPanel Margin="18" Spacing="10">
        <TextBlock x:Name="FileLine" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="PasswordBox" PasswordChar="•" KeyDown="OnKeyDown" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Ok}" Click="OnOk" IsDefault="True" />
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
