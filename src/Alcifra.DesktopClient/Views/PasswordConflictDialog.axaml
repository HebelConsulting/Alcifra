<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.PasswordConflictDialog"
        Title="{loc:Tr PwImport}" Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <!-- One clashing name of an import, asked about on its own (owner decision 2026-10-23: per entry). Cancel stops the
         whole import before anything is filed. -->
    <StackPanel Margin="18" Spacing="16">
        <TextBlock x:Name="MessageBlock" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button Content="{loc:Tr PwImportSkip}" Click="OnSkip" />
            <Button Content="{loc:Tr PwImportNewVersion}" Click="OnNewVersion" />
            <Button Content="{loc:Tr PwImportKeepBoth}" Click="OnKeepBoth" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
