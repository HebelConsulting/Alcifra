<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Alcifra.DesktopClient.Localization"
             xmlns:vm="using:Alcifra.DesktopClient.ViewModels"
             x:Class="Alcifra.DesktopClient.Views.AppointmentForm"
             x:DataType="vm:AppointmentEditViewModel">
  <!-- The appointment's structured fields (ADR 0631), one control for the editor window and the preview's card (#2215):
       the same form in two postures. Where the card shows it, CanEdit is false: nothing can be changed, and the card's
       pencil opens the editor window. -->
  <StackPanel Spacing="10">
    <!-- Which collection the entry belongs to: where a NEW one lands, and on edit where it MOVES to
         (#1122). A DROPDOWN when there is a choice; plain text when there is exactly one, because the
         destination must always be visible (#1125) — showing nothing is how an entry meant for a room's
         Schedule was filed as an availability window. -->
    <Grid ColumnDefinitions="110,*" IsVisible="{Binding ShowTargetPicker}">
      <TextBlock Grid.Column="0" Text="{loc:Tr CalendarCollections}" VerticalAlignment="Center" />
      <ComboBox IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Column="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr CalendarCollections}" />
    </Grid>

    <Grid ColumnDefinitions="110,*" IsVisible="{Binding ShowTargetName}">
      <TextBlock Grid.Column="0" Text="{loc:Tr CalendarCollections}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding TargetName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Grid>

    <Grid ColumnDefinitions="110,*">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptSummary}" VerticalAlignment="Center" />
      <TextBox IsReadOnly="{Binding !$parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Column="1" Text="{Binding Summary}" />
    </Grid>

    <CheckBox IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Content="{loc:Tr ApptAllDay}" IsChecked="{Binding IsAllDay}" Margin="110,0,0,0" />

    <!-- Start and end in the APPOINTMENT'S own zone, each with its OWN zone picker (ADR 0690): iCalendar
         lets DTSTART and DTEND name different TZIDs, and a flight leaving Zurich at 09:00 and landing in
         Boston at 11:30 is exactly that. Nothing here converts between zones (ADR 0631 decision 5) —
         choosing one re-labels the same wall clock, which is what keeps a weekly meeting from drifting
         across a daylight-saving change. The empty entry means a floating time, which stays floating. -->
    <!-- Explicit widths, not Auto: a DatePicker's natural width varies with the locale's date format and
         a time entry's with the font, so Auto let the value run off the right edge. Both were clipped
         mid-value before this was LOOKED at. The time is TYPED, not spun (#1057): a person setting an
         appointment knows the time, and a spinner made them hunt for what four keystrokes say. -->
    <!-- The zone sits UNDER its endpoint rather than beside it: the date and time pickers already fill the
         dialog's width (their own widths vary with the locale, which is why those are explicit), so a
         fourth column got none and the picker rendered as a two-pixel sliver. Found by capturing it. -->
    <!-- The zones are AutoCompleteBoxes, not ComboBoxes (#1126): the list is every zone the host knows —
         several hundred — and scrolling to "Europe/Zurich" is the hunt the typed-value principle exists to
         prevent. FilterMode=Contains so "zurich" finds it without typing "Europe/", and
         MinimumPrefixLength=0 so the full list still drops down for someone who wants to browse. Clearing
         the box is how a time goes back to floating, which is what the watermark says. -->
    <Grid ColumnDefinitions="110,270,8,210,*" RowDefinitions="Auto,Auto,Auto,Auto">
      <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr ApptStart}" VerticalAlignment="Center" />
      <CalendarDatePicker IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Row="0" Grid.Column="1" SelectedDate="{Binding StartDate}" Watermark="yyyy-MM-dd" />
      <TextBox IsReadOnly="{Binding !$parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Row="0" Grid.Column="3" Text="{Binding StartTimeEntry}" Watermark="HH:mm"
               IsVisible="{Binding !IsAllDay}" AutomationProperties.Name="{loc:Tr ApptStart}" />
      <AutoCompleteBox IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding ZoneChoices}"
                       Text="{Binding StartTimeZoneId}" Margin="0,4,0,8"
                       FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="260"
                       HorizontalAlignment="Stretch" IsVisible="{Binding !IsAllDay}"
                       Watermark="{loc:Tr ApptTimesAreFloating}"
                       AutomationProperties.Name="{loc:Tr ApptStartZone}" />

      <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr ApptEnd}" VerticalAlignment="Center" />
      <CalendarDatePicker IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Row="2" Grid.Column="1" SelectedDate="{Binding EndDate}" Watermark="yyyy-MM-dd" />
      <TextBox IsReadOnly="{Binding !$parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Row="2" Grid.Column="3" Text="{Binding EndTimeEntry}" Watermark="HH:mm"
               IsVisible="{Binding !IsAllDay}" AutomationProperties.Name="{loc:Tr ApptEnd}" />
      <AutoCompleteBox IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" ItemsSource="{Binding ZoneChoices}"
                       Text="{Binding EndTimeZoneId}" Margin="0,4,0,0"
                       FilterMode="Contains" MinimumPrefixLength="0" MaxDropDownHeight="260"
                       HorizontalAlignment="Stretch" IsVisible="{Binding !IsAllDay}"
                       Watermark="{loc:Tr ApptTimesAreFloating}"
                       AutomationProperties.Name="{loc:Tr ApptEndZone}" />
    </Grid>

    <Grid ColumnDefinitions="110,*">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptLocation}" VerticalAlignment="Center" />
      <TextBox IsReadOnly="{Binding !$parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Column="1" Text="{Binding Location}" />
    </Grid>

    <Grid ColumnDefinitions="110,*">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptUrl}" VerticalAlignment="Center" />
      <TextBox IsReadOnly="{Binding !$parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Column="1" Text="{Binding Url}" Watermark="https://" />
    </Grid>

    <Grid ColumnDefinitions="110,*">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptDescription}" VerticalAlignment="Top" Margin="0,6,0,0" />
      <TextBox IsReadOnly="{Binding !$parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Column="1" Text="{Binding Description}" AcceptsReturn="True"
               TextWrapping="Wrap" MinHeight="70" />
    </Grid>

    <!-- Recurrence, editable for the repeats the shared list offers (#1133) — daily hours, WORKING DAYS,
         a weekly slot. A rule richer than the list (every second Tuesday, the last Thursday of a month)
         arrived over CalDAV and is STATED instead, because offering the nearest button would rewrite it
         on the next save. -->
    <Grid ColumnDefinitions="110,*" IsVisible="{Binding !RepeatIsRicherThanOffered}">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptRepeats}" VerticalAlignment="Center" />
      <ComboBox IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" Grid.Column="1" ItemsSource="{Binding RepeatOptions}" SelectedItem="{Binding SelectedRepeat}"
                HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr ApptRepeats}" />
    </Grid>

    <!-- WHICH days a weekly repeat falls on (#1136) — "Mon, Wed, Fri", which neither "every week" nor the
         weekdays preset could say. Drawn in the culture's own order; the rule's order is fixed. Ticking
         none leaves a plain weekly repeat, which already means the entry's own weekday. -->
    <Grid ColumnDefinitions="110,*" IsVisible="{Binding ChoosesWeekdays}">
      <TextBlock Grid.Column="0" Text="{loc:Tr RepeatOnDays}" VerticalAlignment="Center" />
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Weekdays}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AppointmentEditViewModel+WeekdayChoice">
            <CheckBox IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" IsChecked="{Binding IsChecked}" Content="{Binding Label}"
                      AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- When it stops. An availability window may be left open — an offer takes nothing from anyone — while
         a booking or a block must end, because two endless claims cannot be compared for overlap. -->
    <Grid ColumnDefinitions="110,*" IsVisible="{Binding RepeatsOnAChoice}">
      <TextBlock Grid.Column="0" Text="{loc:Tr RepeatUntil}" VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Spacing="2">
        <CalendarDatePicker IsEnabled="{Binding $parent[UserControl].((vm:AppointmentEditViewModel)DataContext).CanEdit}" SelectedDate="{Binding RepeatUntil}" Watermark="yyyy-MM-dd" HorizontalAlignment="Left" />
        <TextBlock Text="{loc:Tr RepeatUntilHint}" Foreground="{DynamicResource WbMuted}"
                   FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="110,*" IsVisible="{Binding RepeatIsRicherThanOffered}">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptRepeats}" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="2">
        <SelectableTextBlock Text="{Binding RecurrenceText}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Tr ApptRecurrenceReadOnly}" Foreground="{DynamicResource WbMuted}"
                   FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <!-- Attendees: shown, never edited. This product never sends a scheduling message (ADR 0631
         decision 3), so an editable field would let this copy diverge from everybody else's. -->
    <Grid ColumnDefinitions="110,*" IsVisible="{Binding HasAttendees}">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptAttendees}" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="2">
        <ItemsControl ItemsSource="{Binding Attendees}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AttendeeRowViewModel">
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Address}" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{DynamicResource WbMuted}"
                           FontSize="11" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{loc:Tr ApptAttendeesReadOnly}" Foreground="{DynamicResource WbMuted}"
                   FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <!-- Says a reminder is set without implying it can be changed here. -->
    <Grid ColumnDefinitions="110,*" IsVisible="{Binding HasReminders}">
      <TextBlock Grid.Column="0" Text="{loc:Tr ApptReminder}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding ReminderSummary}" Foreground="{DynamicResource WbMuted}"
                 TextWrapping="Wrap" />
    </Grid>

    <TextBlock Text="{loc:Tr ApptPreservedNote}" IsVisible="{Binding CanEdit}" Foreground="{DynamicResource WbMuted}"
               TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
  </StackPanel>
</UserControl>
