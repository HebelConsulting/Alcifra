<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:Projektanker.Icons.Avalonia"
             xmlns:loc="using:Alcifra.DesktopClient.Localization"
             xmlns:v="using:Alcifra.DesktopClient.Views"
             xmlns:vm="using:Alcifra.DesktopClient.ViewModels"
             x:Class="Alcifra.DesktopClient.Views.PasswordEntryView"
             x:DataType="vm:PasswordEntryPreviewViewModel">

  <!-- An opened password entry in the preview pane (ADR 0968): its name, "Exposed since", and its fields in the core's
       order. A secret shows only while its eye is held; copying a secret clears the clipboard after 30 s. The find box
       above lights the hits in what is VISIBLE: the name, the labels and the plain values, never a secret's value. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,12" Spacing="10" MaxWidth="720" HorizontalAlignment="Left">

      <TextBlock v:FindRunsText.Runs="{Binding NameRuns}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

      <Border IsVisible="{Binding HasNotice}" Background="{DynamicResource WbSurface}" BorderBrush="{DynamicResource WbWarning}"
              BorderThickness="1" CornerRadius="4" Padding="8,6">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <i:Icon Value="mdi-alert-outline" FontSize="16" Foreground="{DynamicResource WbWarning}" VerticalAlignment="Top" />
          <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" MaxWidth="640" />
        </StackPanel>
      </Border>

      <TextBlock Text="{loc:Tr PwReadOnlyHere}" IsVisible="{Binding IsReadOnly}" Foreground="{DynamicResource WbMuted}" FontSize="12" TextWrapping="Wrap" />

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SecretFieldViewModel">
            <Grid ColumnDefinitions="150,*,Auto" Margin="0,4">
              <TextBlock Grid.Column="0" v:FindRunsText.Runs="{Binding LabelRuns}" Foreground="{DynamicResource WbMuted}"
                         VerticalAlignment="Top" Margin="0,4,12,0" TextWrapping="Wrap" />
              <Border Grid.Column="1" Background="{DynamicResource WbChrome}" BorderBrush="{DynamicResource WbBorder}" BorderThickness="1"
                      CornerRadius="4" Padding="8,4" MinHeight="28">
                <Panel>
                  <TextBlock v:FindRunsText.Runs="{Binding ValueRuns}" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="{Binding !IsLink}"
                             Classes.code="{Binding IsCode}" />
                  <!-- A verification code (ADR 1013): the code valid now, always shown, and the seconds it stays valid. -->
                  <StackPanel IsVisible="{Binding IsCode}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding CountdownPercent}" Minimum="0" Maximum="100" Width="60" MinWidth="60" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Countdown}" Foreground="{DynamicResource WbMuted}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                  <!-- The URL opens in the browser (#1949), drawn as the index field's links are; find still lights it. -->
                  <HyperlinkButton IsVisible="{Binding IsLink}" Command="{Binding OpenLinkCommand}" Padding="0" VerticalAlignment="Center">
                    <TextBlock v:FindRunsText.Runs="{Binding ValueRuns}" TextWrapping="Wrap" />
                  </HyperlinkButton>
                </Panel>
              </Border>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0" VerticalAlignment="Top">
                <!-- The eye: held, not clicked (mouse button down, or Space held). -->
                <Button IsVisible="{Binding HasEye}" v:HoldToReveal.Target="{Binding}" Padding="6,4"
                        ToolTip.Tip="{loc:Tr PwHoldToShow}" AutomationProperties.Name="{loc:Tr PwHoldToShow}">
                  <i:Icon Value="{Binding EyeIcon}" FontSize="16" />
                </Button>
                <Button Command="{Binding CopyCommand}" Padding="6,4" ToolTip.Tip="{loc:Tr PwCopy}" AutomationProperties.Name="{loc:Tr PwCopy}">
                  <i:Icon Value="mdi-content-copy" FontSize="16" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
