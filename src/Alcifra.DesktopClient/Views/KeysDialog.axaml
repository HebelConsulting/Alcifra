<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.KeysDialog"
        Title="{loc:Tr KeysTitleMine}" Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <!-- One row per key: its label, its state (or when and why it was revoked), and Revoke where the server
             advertised the key's `revoke` rel (#2278). Built in code, as the passkeys list is. -->
        <StackPanel x:Name="KeysPanel" Spacing="8" />
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource WbMuted}" FontSize="12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Close}" Click="OnClose" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
