<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        xmlns:vm="using:Alcifra.DesktopClient.ViewModels"
        xmlns:api="using:Alcifra.ApiClient"
        xmlns:i="using:Projektanker.Icons.Avalonia"
        x:Class="Alcifra.DesktopClient.Views.ContentAudienceDialog"
        x:DataType="vm:AudienceEditor"
        Title="{loc:Tr AudTitle}" Width="560" Height="520" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="18">
        <TextBlock x:Name="Subject" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Margin="0,6,0,10" TextWrapping="Wrap" Foreground="{DynamicResource WbMuted}"
                   Text="{Binding Explanation}" />

        <!-- The readers who may be added (ADR 0983): only these, the same list the server accepts. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" IsVisible="{Binding CanEdit}">
            <ComboBox x:Name="CandidateBox" Width="320" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                      PlaceholderText="{loc:Tr AudPickReader}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="api:AudienceCandidateInfo">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button x:Name="AddButton" Content="{loc:Tr AudAdd}" IsEnabled="{Binding CanAdd}" Click="OnAdd" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding Problem}" Foreground="#c62828" TextWrapping="Wrap" IsVisible="{Binding Problem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{loc:Tr AudMissingReader}" FontSize="12" Foreground="{DynamicResource WbMuted}" TextWrapping="Wrap"
                       IsVisible="{Binding CanEdit}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="SaveButton" Content="{loc:Tr AudSave}" IsEnabled="{Binding CanSave}" IsVisible="{Binding CanEdit}"
                        Click="OnSave" IsDefault="True" />
                <Button Content="{loc:Tr Close}" Click="OnClose" IsCancel="True" />
            </StackPanel>
        </StackPanel>

        <ListBox ItemsSource="{Binding Rows}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AudienceEditorRow">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <i:Icon Grid.Column="0" Value="mdi-account-outline" FontSize="15" VerticalAlignment="Center" IsVisible="{Binding !IsGroup}" />
                        <i:Icon Grid.Column="0" Value="mdi-account-group-outline" FontSize="15" VerticalAlignment="Center" IsVisible="{Binding IsGroup}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{DynamicResource WbMuted}"
                                       IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Content="{loc:Tr AudManager}" IsChecked="{Binding IsManager}"
                                  IsVisible="{Binding CanBeManager}"
                                  IsEnabled="{Binding $parent[Window].((vm:AudienceEditor)DataContext).CanEdit}" />
                        <Button Grid.Column="3" Content="{loc:Tr AudRemove}" Click="OnRemove" Tag="{Binding}"
                                IsVisible="{Binding $parent[Window].((vm:AudienceEditor)DataContext).CanEdit}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
