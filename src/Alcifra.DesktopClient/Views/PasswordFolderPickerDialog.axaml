<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        xmlns:vm="using:Alcifra.DesktopClient.ViewModels"
        x:Class="Alcifra.DesktopClient.Views.PasswordFolderPickerDialog"
        Title="{loc:Tr PwMove}" Width="420" Height="420" WindowStartupLocation="CenterOwner">
    <!-- Where in the SAME store a password item goes (ADR 0968): an entry is sealed to its store's readers, so the choices
         are that store's folders only, indented under their parents. -->
    <DockPanel Margin="18" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button x:Name="MoveButton" Content="{loc:Tr PwMove}" Click="OnMove" IsDefault="True" />
        </StackPanel>
        <ListBox x:Name="Choices">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PasswordFolderChoice">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
