<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.DeviceEditDialog"
        Title="{loc:Tr DvEnrolTitle}" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock Text="{loc:Tr DvName}" FontWeight="SemiBold" FontSize="12" />
        <TextBox x:Name="NameBox" Watermark="{loc:Tr DvNameHint}" MaxLength="100" />

        <TextBlock Text="{loc:Tr DvColReaches}" FontWeight="SemiBold" FontSize="12" />
        <WrapPanel>
            <CheckBox x:Name="MailBox" Content="{loc:Tr DvMail}" Margin="0,0,14,0" IsChecked="True" />
            <CheckBox x:Name="FilesBox" Content="{loc:Tr DvFiles}" Margin="0,0,14,0" IsChecked="True" />
            <CheckBox x:Name="CalendarsBox" Content="{loc:Tr DvCalendars}" Margin="0,0,14,0" IsChecked="True" />
            <CheckBox x:Name="ContactsBox" Content="{loc:Tr DvContacts}" IsChecked="True" />
        </WrapPanel>

        <!-- Mail encryption, with the known client limitation beside it (owner, 2026-10-29). Locked on where the
             organisation seals mail: the setting is shown, not offered. -->
        <CheckBox x:Name="EncryptBox" Content="{loc:Tr DvEncryptMail}" />
        <TextBlock x:Name="LockedText" Text="{loc:Tr DvEncryptLocked}" IsVisible="False"
                   Foreground="{DynamicResource WbMuted}" FontSize="12" />
        <TextBlock Text="{loc:Tr DvEncryptHint}" TextWrapping="Wrap" Foreground="{DynamicResource WbMuted}" FontSize="12" />

        <!-- Calendars and contacts (#2090): all, or the user's own plus the ticked shared ones — what an iPhone or iPad
             shows, since it cannot pick by itself. Only for a device that reaches calendars or contacts. -->
        <StackPanel x:Name="CollectionsPanel" Spacing="6" IsVisible="False">
            <TextBlock Text="{loc:Tr DvCollections}" FontWeight="SemiBold" FontSize="12" />
            <RadioButton x:Name="AllCollections" GroupName="Collections" Content="{loc:Tr DvCollectionsAll}" IsChecked="True" />
            <RadioButton x:Name="ChosenCollections" GroupName="Collections" Content="{loc:Tr DvCollectionsChosen}" />
            <ScrollViewer MaxHeight="180" IsVisible="{Binding #ChosenCollections.IsChecked}">
                <StackPanel x:Name="CollectionList" Margin="24,0,0,0" Spacing="2" />
            </ScrollViewer>
            <TextBlock Text="{loc:Tr DvCollectionsHint}" TextWrapping="Wrap" Foreground="{DynamicResource WbMuted}" FontSize="12" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#c62828" FontSize="12" TextWrapping="Wrap" IsVisible="False" />

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="{loc:Tr Save}" Click="OnSave" IsDefault="True" />
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
