<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.RevokeKeyDialog"
        Title="{loc:Tr RevokeTitle}" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" />
        <!-- The holder's only valid key: until another is enrolled, nothing sealed opens. -->
        <TextBlock x:Name="OnlyKeyText" IsVisible="False" TextWrapping="Wrap" FontWeight="SemiBold"
                   Foreground="{DynamicResource WbWarning}" Text="{loc:Tr RevokeOnlyKey}" />
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WbMuted}" FontSize="12" Text="{loc:Tr RevokeAdvice}" />

        <TextBlock Text="{loc:Tr RevokeReason}" FontWeight="SemiBold" FontSize="12" />
        <!-- No reason is preselected: the reason is the one thing this dialog asks, and a default would be given unread. -->
        <StackPanel x:Name="ReasonsPanel" Spacing="2" />
        <TextBox x:Name="OtherBox" IsVisible="False" Watermark="{loc:Tr RevokeOtherText}" MaxLength="200" />

        <TextBlock x:Name="StatusText" Foreground="{DynamicResource WbMuted}" FontSize="12" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button x:Name="RevokeButton" Content="{loc:Tr RevokeSubmit}" IsEnabled="False" Click="OnRevoke" />
        </StackPanel>
    </StackPanel>
</Window>
