<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.CheckInCommentDialog"
        Title="{loc:Tr CoCheckIn}" Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="12">
        <TextBlock Text="{loc:Tr FilingCommentLabel}" />
        <TextBox x:Name="CommentBox" Watermark="{loc:Tr FilingCommentPlaceholder}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
            <Button x:Name="CheckInButton" Content="{loc:Tr CoCheckIn}" Click="OnCheckIn" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
