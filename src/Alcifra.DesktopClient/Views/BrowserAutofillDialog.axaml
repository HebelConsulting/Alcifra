<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.BrowserAutofillDialog"
        Title="{loc:Tr BrowserAutofillTitle}" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="10">
        <TextBlock TextWrapping="Wrap" Text="{loc:Tr BrowserAutofillBody}" />
        <CheckBox x:Name="EnabledBox" Content="{loc:Tr BrowserAutofillEnable}" />
        <!-- The id is what the browser shows when the unpacked extension is loaded; the manifest allows exactly that
             one origin, so a wrong id means the extension never reaches the host. -->
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WbMuted}" Text="{loc:Tr BrowserAutofillIdHint}" />
        <TextBox x:Name="ExtensionBox" Watermark="{loc:Tr BrowserAutofillIdWatermark}" />
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WbMuted}" Text="{loc:Tr BrowserAutofillScope}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="{loc:Tr Save}" Click="OnSave" IsDefault="True" />
            <Button Content="{loc:Tr Cancel}" Click="OnCancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
