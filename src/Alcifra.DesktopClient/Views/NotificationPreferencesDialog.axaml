<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Alcifra.DesktopClient.Localization"
        x:Class="Alcifra.DesktopClient.Views.NotificationPreferencesDialog"
        Title="{loc:Tr NotifPrefTitle}" Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="18" Spacing="12">
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource WbMuted}"
                   Text="{loc:Tr NotifPrefBody}" />
        <!-- Two channels per type (#1729): email, and the phone's push (ADR 0919). -->
        <Grid ColumnDefinitions="*,64,64">
            <TextBlock Grid.Column="1" Text="{loc:Tr NotifPrefEmail}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{loc:Tr NotifPrefPhone}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
        </Grid>
        <ItemsControl x:Name="PrefList">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                    <Grid ColumnDefinitions="*,64,64" Margin="0,2">
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <CheckBox Grid.Column="1" IsChecked="{Binding EmailEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                        <CheckBox Grid.Column="2" IsChecked="{Binding PhoneEnabled, Mode=TwoWay}" HorizontalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Error" Foreground="#c0392b" IsVisible="False" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{loc:Tr Cancel}" Click="OnClose" IsCancel="True" />
            <Button x:Name="SaveButton" Content="{loc:Tr Save}" Click="OnSave" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
