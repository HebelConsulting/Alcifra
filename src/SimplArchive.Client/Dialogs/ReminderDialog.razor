@inject HttpClient Http
@inject ISnackbar Snackbar

@* Set / view / cancel reminders (Wiedervorlage) on a document (ADR "Document reminders"): a date-time, an
   optional note, an optional repeat, and an optional target colleague (defaults to yourself). Lists the
   pending reminders you set or are the target of, each cancellable. Interactive — does its own API calls. *@
<MudDialog>
    <DialogContent>
        <div style="min-width: 460px;">
            <MudText Typo="Typo.subtitle2" Class="mb-2">@((MarkupString)string.Format(Strings.Get("ReminderTitle"), DocumentName))</MudText>

            @if (_reminders.Count > 0)
            {
                <MudList T="string" Dense="true" Class="mb-1">
                    @foreach (var r in _reminders)
                    {
                        <MudListItem T="string">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.Alarm" Size="Size.Small" />
                                <div style="flex:1 1 auto; min-width:0;">
                                    <div>@r.RemindAt.InZone(SessionTimeZone.Current).ToString("g")@(r.Recurrence != 0 ? string.Format(Strings.Get("ReminderRepeatsSuffix"), r.RecurrenceName.ToLowerInvariant()) : "")</div>
                                    <div class="mud-text-secondary" style="font-size:.8em;">@string.Format(Strings.Get("ReminderForLine"), r.TargetName, string.IsNullOrEmpty(r.Note) ? "" : " — " + r.Note)</div>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" aria-label="@Strings.Get("ReminderCancelAria")" OnClick="@(() => CancelAsync(r))" />
                            </div>
                        </MudListItem>
                    }
                </MudList>
                <MudDivider Class="my-2" />
            }

            <MudDatePicker Editable="true" PickerVariant="PickerVariant.Dialog" @bind-Date="_date" Label="@Strings.Get("ReminderDate")" MinDate="_today" DateFormat="yyyy-MM-dd" Variant="Variant.Outlined" Class="mb-2" />
            <MudTimePicker Editable="true" PickerVariant="PickerVariant.Dialog" @bind-Time="_time" Label="@Strings.Get("ReminderTime")" Variant="Variant.Outlined" Class="mb-2" />
            <MudTextField @bind-Value="_note" Label="@Strings.Get("ReminderNote")" Variant="Variant.Outlined" Class="mb-2" />
            <MudSelect T="int" @bind-Value="_recurrence" Label="@Strings.Get("ReminderRepeat")" Variant="Variant.Outlined" Class="mb-2">
                <MudSelectItem T="int" Value="@(0)">@Strings.Get("RecurNone")</MudSelectItem>
                <MudSelectItem T="int" Value="@(1)">@Strings.Get("RecurDaily")</MudSelectItem>
                <MudSelectItem T="int" Value="@(2)">@Strings.Get("RecurWeekly")</MudSelectItem>
                <MudSelectItem T="int" Value="@(3)">@Strings.Get("RecurMonthly")</MudSelectItem>
            </MudSelect>
            <MudSelect T="Guid" @bind-Value="_target" Label="@Strings.Get("ReminderRemindLabel")" Variant="Variant.Outlined">
                <MudSelectItem T="Guid" Value="@Guid.Empty">@Strings.Get("ReminderMyself")</MudSelectItem>
                @foreach (var t in _targets)
                {
                    <MudSelectItem T="Guid" Value="@t.Id">@t.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Close())">@Strings.Get("Close")</MudButton>
        @* Greyed until the list has answered with its `create` rel: a click before that returned silently. *@
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_date is null || _busy || _createHref is null)" OnClick="CreateAsync">@Strings.Get("ReminderSet")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter] public Guid DocumentId { get; set; }
    [Parameter] public string DocumentName { get; set; } = string.Empty;

    // Set when the dialog opens (below), not here: "today" belongs to the moment and zone of opening.
    private DateTime _today;
    private DateTime? _date;
    private TimeSpan? _time = ReminderSchedule.DefaultTime.ToTimeSpan();
    private string _note = string.Empty;
    private int _recurrence;
    private Guid _target = Guid.Empty;
    private bool _busy;
    private List<TargetDto> _targets = [];
    private List<ReminderDto> _reminders = [];

    // The document's reminder collection, handed in from the detail pane's `reminders` rel. Everything else the
    // dialog needs — the target catalog, creating one, cancelling one — is a rel ON that collection or on a row
    // of it, so this is the only address the dialog is told (ADR 0543, issue #416).
    [Parameter] public string? RemindersHref { get; set; }

    private string? _createHref;

    protected override async Task OnInitializedAsync()
    {
        // Tomorrow as a calendar day in the zone this session shows times in — never "now plus 24 hours" and never
        // today's offset (#1909, Presentation.ReminderSchedule) — the zone the pending list above is rendered in.
        var tomorrow = ReminderSchedule.DefaultDate(TimeProvider.System.GetUtcNow(), SessionTimeZone.Current);
        _today = tomorrow.AddDays(-1).ToDateTime(TimeOnly.MinValue);
        _date = tomorrow.ToDateTime(TimeOnly.MinValue);

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            // Never silently: an absent address used to leave the dialog open, fully interactive, and unable
            // to save anything (#420). The caller resolves it now, so this is a bug guard rather than a state.
            if (RemindersHref is null)
            {
                throw new InvalidOperationException("The reminder dialog was opened without a reminders address (ADR 0543).");
            }

            var list = await Http.GetFromJsonAsync<ReminderListResponse>(RemindersHref);
            _reminders = list?.Reminders ?? [];
            _createHref = Rel(list?.Links, "create");
            if (Rel(list?.Links, "targets") is { } targetsHref)
            {
                _targets = (await Http.GetFromJsonAsync<TargetsResponse>(targetsHref))?.Targets ?? [];
            }
        }
        catch (Exception)
        {
            // best-effort — leave the lists empty
        }
    }

    private async Task CreateAsync()
    {
        if (_date is not { } date)
        {
            return;
        }

        _busy = true;
        try
        {
            // Placed with the offset the session's zone has at THAT wall time. It used to take today's offset,
            // which is an hour off across a clock change — and, because the default date carried
            // DateTimeKind.Local, made the constructor throw the whole day before each change (#1909).
            var when = WallClock.At(DateOnly.FromDateTime(date), TimeOnly.FromTimeSpan(_time ?? TimeSpan.Zero), SessionTimeZone.Current);
            var body = new
            {
                remindAt = when,
                note = _note,
                recurrence = _recurrence,
                targetUserId = _target == Guid.Empty ? (Guid?)null : _target,
                // The zone the day and time were placed in, so a recurring reminder repeats at this wall time
                // across clock changes rather than at the same UTC instant (#1911, ADR 0972).
                timeZone = SessionTimeZone.IanaId,
            };
            if (_createHref is null) { return; }

            using var response = await Http.PostAsJsonAsync(_createHref, body);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add(Strings.Get("ReminderSetOk"), Severity.Success);
                _note = string.Empty;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(Strings.Get("ReminderSetError"), Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("ReminderSetError"), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync(ReminderDto reminder)
    {
        if (Rel(reminder.Links, "cancel") is not { } href) { return; }

        try
        {
            using var response = await Http.DeleteAsync(href);
            await LoadAsync();
        }
        catch (Exception)
        {
            Snackbar.Add(Strings.Get("ReminderCancelError"), Severity.Error);
        }
    }

    private record TargetsResponse { public List<TargetDto> Targets { get; set; } = []; }
    private record TargetDto { public Guid Id { get; set; } public string DisplayName { get; set; } = string.Empty; }
    private record ReminderListResponse { public List<ReminderDto> Reminders { get; set; } = []; public List<LinkDto> Links { get; set; } = []; }
    private record LinkDto { public string Rel { get; set; } = string.Empty; public string Href { get; set; } = string.Empty; }
    private record ReminderDto { public Guid Id { get; set; } public DateTimeOffset RemindAt { get; set; } public string? Note { get; set; } public int Recurrence { get; set; } public string RecurrenceName { get; set; } = string.Empty; public string TargetName { get; set; } = string.Empty; public List<LinkDto> Links { get; set; } = []; }

    private static string? Rel(List<LinkDto>? links, string rel)
    {
        var href = links?.FirstOrDefault(l => l.Rel == rel)?.Href;
        return href is null ? null : href.TrimStart('/');
    }
}
