@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject SimplArchive.Client.Services.ApiRoot ApiRoot

@* The Tenant tab's "Reader certificates" group (ADR 0936), as the desktop shows it (ADR 0511): whether people enrol
   their own reader certificate, and where the "Reader certificates" folder is created. Its own resource, followed
   from the root, saved whole with If-Match; the tab owns the header (its pencil and Save/Cancel). Present only while
   a module that licenses enrolment is active and the caller administers modules. *@
@if (_settings is not null)
{
    @Header
    <div style="display:flex; align-items:center; gap:4px;">
        <MudSwitch T="bool" @bind-Value="_edit.SelfServiceEnabled" Disabled="@(!Editing)" Color="Color.Primary" Class="flex-grow-1"
                   Label="@Strings.Get("TenantCertSelfService")" />
        <InfoButton Text="@(Strings.Get("TenantCertSelfServiceInfo"))" />
    </div>
    <div style="display:flex; align-items:center; gap:8px;" class="mb-4">
        <MudText Typo="Typo.body2" Class="flex-grow-1">
            @Strings.Get("TenantCertParent"): <b>@(_edit.ParentFolderName ?? Strings.Get("TenantCertParentNone"))</b>
        </MudText>
        @if (Editing)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ChooseParentAsync">@Strings.Get("TenantCertChoose")</MudButton>
            @if (_edit.ParentFolderId is not null)
            {
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearParent">@Strings.Get("TenantCertClear")</MudButton>
            }
        }
        <InfoButton Text="@(Strings.Get("TenantCertParentInfo"))" />
    </div>
}

@code {
    /// <summary>Whether this group is the one in edit mode (the tab decides, so only one group edits at a time).</summary>
    [Parameter] public bool Editing { get; set; }

    /// <summary>The tab's group header (title, pencil, Save/Cancel), shown with the group.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    private SettingsDto? _settings;
    private SettingsDto _edit = new();
    private string? _href;
    private string? _etag;

    protected override Task OnInitializedAsync() => ReloadAsync();

    /// <summary>Re-reads the settings (on load, on Cancel, and after any tenant save: they share the tenant's tag).</summary>
    public async Task ReloadAsync()
    {
        try
        {
            if (await ApiRoot.HrefAsync("certificateSettings") is not { } href)
            {
                _settings = null;   // no module licensing enrolment is active here (ADR 0543)
                return;
            }

            using var response = await Http.GetAsync(href);
            if (!response.IsSuccessStatusCode)
            {
                _settings = null;   // 403: the caller does not administer modules, so the group is not theirs to see
                return;
            }

            _href = href;
            _etag = response.Headers.ETag?.Tag;
            _settings = await response.Content.ReadFromJsonAsync<SettingsDto>();
            _edit = _settings! with { };
        }
        catch (Exception e) when (e is HttpRequestException or System.Text.Json.JsonException)
        {
            _settings = null;
        }
        finally
        {
            StateHasChanged();
        }
    }

    /// <summary>Saves the whole value with the tag of the read that filled the form; true when it was saved.</summary>
    public async Task<bool> SaveAsync()
    {
        if (_href is null)
        {
            return false;
        }

        using var request = new HttpRequestMessage(HttpMethod.Put, _href)
        {
            Content = JsonContent.Create(new { selfServiceEnabled = _edit.SelfServiceEnabled, parentFolderId = _edit.ParentFolderId }),
        };
        if (_etag is not null)
        {
            request.Headers.TryAddWithoutValidation("If-Match", _etag);
        }

        using var response = await Http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            string? code = null;
            try
            {
                var problem = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                code = problem.TryGetProperty("errorCode", out var c) ? c.GetString() : null;
            }
            catch (System.Text.Json.JsonException)
            {
            }

            Snackbar.Add(code is not null ? SimplArchive.Localization.ApiErrorText.For(code) : Strings.Get("StErrSaveSettings"), Severity.Warning);
            return false;
        }

        return true;
    }

    private async Task ChooseParentAsync()
    {
        var dialog = await DialogService.ShowAsync<SimplArchive.Client.Dialogs.FolderPickerDialog>(Strings.Get("TenantCertParent"));
        if (await dialog.Result is { Canceled: false, Data: Guid folderId })
        {
            // The name arrives with the next read; until then the id stands in, so the form shows that something changed.
            _edit = _edit with { ParentFolderId = folderId, ParentFolderName = folderId.ToString() };
        }
    }

    private void ClearParent() => _edit = _edit with { ParentFolderId = null, ParentFolderName = null };

    private sealed record SettingsDto
    {
        public bool SelfServiceEnabled { get; set; }
        public Guid? ParentFolderId { get; set; }
        public string? ParentFolderName { get; set; }
    }
}
