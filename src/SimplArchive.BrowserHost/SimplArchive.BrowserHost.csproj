<Project Sdk="Microsoft.NET.Sdk">

  <!-- The browser autofill host (owner, 2026-10-25): ONE implementation of Chrome's native-messaging protocol and
       the fill/save commands, served by BOTH the desktop client and sapass — each registers its own host name, and
       the extension tries them in order. A leaf referencing the shared client and the card code, no UI: the PIN
       prompt is a delegate the host application supplies. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SimplArchive.ApiClient/SimplArchive.ApiClient.csproj" />
    <ProjectReference Include="../SimplArchive.HardwareKeys/SimplArchive.HardwareKeys.csproj" />
  </ItemGroup>

</Project>
