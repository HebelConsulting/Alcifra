<Project Sdk="Microsoft.NET.Sdk">

  <!-- The brand's icon generator (ADR 0993): renders every icon the desktop packages and the web serve, from the
       brand's SVG icon or the drawn cabinet in the brand's colours, into BrandIconsDir. Run by the build
       (Directory.Build.targets), never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.18" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.18" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.18" />
    <!-- Skia without fontconfig on Linux (#2325): the icons are SVG and need no system font, and fontconfig was the one
         thing the image build asked a distribution mirror for. The default Linux assets, which link it, are left out. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" ExcludeAssets="all" />
    <PackageReference Include="Avalonia.Svg" Version="11.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generator's own switches stop here: passed on, they made Theming a second configuration that a solution
         build compiled in parallel with the normal one, into the same bin/ and obj/ folders (#2357). -->
    <ProjectReference Include="..\Alcifra.Theming\Alcifra.Theming.csproj" GlobalPropertiesToRemove="BrandIconsPhase;BrandIconsDir" />
  </ItemGroup>

  <ItemGroup>
    <BrandIconInput Include="$(BrandFile);$(BrandAssetsDir)**\*.svg" />
  </ItemGroup>

  <!-- Only when a consumer asks (BrandIconsPhase=Generate), so building the solution does not generate a second time
       beside it. Incremental: it reruns when the brand or this tool changed. -->
  <Target Name="GenerateBrandIcons" AfterTargets="Build" Condition="'$(BrandIconsPhase)' == 'Generate'"
          Inputs="@(BrandIconInput);$(TargetPath)" Outputs="$(BrandIconsDir)app.ico">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(BrandIconsDir)&quot; &quot;$(BrandAssetsDir)&quot;" />
  </Target>

</Project>
