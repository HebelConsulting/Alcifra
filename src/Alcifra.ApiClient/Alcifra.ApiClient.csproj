<Project Sdk="Microsoft.NET.Sdk">

  <!-- Published for the mobile app (ADR 0917): shared metadata, version stamped by the publish workflow. -->
  <!-- Conditional: the Docker restore layer copies .csproj files only, and this carries package metadata, nothing a restore needs. -->
  <Import Project="..\..\build\ClientPackages.props" Condition="Exists('..\..\build\ClientPackages.props')" />
  <PropertyGroup>
    <Description>The hypermedia API client the $(ProductName) desktop and mobile apps share (ADR 0917).</Description>
  </PropertyGroup>

  <!-- TargetFramework is set explicitly for the Docker restore layer, as every project does. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The hypermedia API client the desktop and the mobile app share (ADR 0917): plain HttpClient/JSON over the
       advertised rels, UI-free. What differs per host is a constructor argument or a seam (IEnvelopeOpener,
       ILogger, the token handler), never a host type. -->

  <ItemGroup>
    <!-- Pinned above what other packages bring (10.0.0/10.0.9): CVE-2026-84008 and CVE-2026-70162, fixed in 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <!-- MimeKit (MIT) — reads the S/MIME envelope a strict-tier read arrives in (#1353, ADR 0828; SmimeEnvelope).
         Same version Infrastructure builds those envelopes with, deliberately: two versions of one format is how
         a producer and a consumer come to disagree about it. -->
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!-- The live notification hub (ADR "Real-time notifications (SignalR)"), for the desktop and the phone (mobile #20). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alcifra.Localization\Alcifra.Localization.csproj" />
    <ProjectReference Include="..\Alcifra.Presentation\Alcifra.Presentation.csproj" />
    <!-- The find-in-document word source's local half (WordLayoutSource): PDF bytes to word boxes, pure managed. -->
    <ProjectReference Include="..\Alcifra.TextLayout\Alcifra.TextLayout.csproj" />
    <!-- The .alcifra container's reader (ADR 0961): a road copy opens into the same responder as an export. -->
    <ProjectReference Include="..\Alcifra.SealedArchive\Alcifra.SealedArchive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The device flow's body classification — is this an answer, or a transient failure the poll must survive? —
         is asserted directly by Alcifra.UnitTests. The flow is public; only that seam is internal. -->
    <InternalsVisibleTo Include="Alcifra.UnitTests" />
  </ItemGroup>

</Project>
