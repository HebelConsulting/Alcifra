{
  "manifest_version": 3,
  "name": "Alcifra autofill",
  "version": "0.2.0",
  "description": "Fills logins from your Alcifra password store, opened with your hardware key, and keeps your bookmarks in step.",
  "permissions": [
    "alarms",
    "bookmarks",
    "nativeMessaging",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "autofill.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
