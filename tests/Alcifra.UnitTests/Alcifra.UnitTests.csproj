<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The icon tests read the generated brand icons (ADR 0993), so the generator runs before this compiles. -->
    <UsesBrandIcons>true</UsesBrandIcons>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The theming library and its generator (ADR 0578): the tests assert that the checked-in generated
       files still match the tokens, and that the shipped palette clears the same contrast bar every custom
       theme is held to. -->
  <ItemGroup>
    <!-- The load harness (#705) is a console app, so its rules are not otherwise covered by anything: a verdict
         that has only ever been seen to say PASS is not a verdict anyone should act on. -->
    <ProjectReference Include="..\Alcifra.LoadTest\Alcifra.LoadTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Alcifra.Theming\Alcifra.Theming.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Architecture tests (ADR "Architecture tests (NetArchTest)") — assert the Clean Architecture layering. -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- MIT, already in the tree through MimeKit and the Messenger client. Aliased because WebPush brings the OLD
         Portable.BouncyCastle with the same namespaces; the sealed-archive tests open EC key agreement with it, as a card
         does (SealedArchiveTestKeys). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" Aliases="BouncyCastleCryptography" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- For testing the ASP.NET Core logging middleware (ADR "Enterprise-grade structured logging") against a
       DefaultHttpContext. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Alcifra.Domain\Alcifra.Domain.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.Application\Alcifra.Application.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.Client\Alcifra.Client.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.BrowserHost\Alcifra.BrowserHost.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.Sapass\Alcifra.Sapass.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.Presentation\Alcifra.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.ApiClient\Alcifra.ApiClient.csproj" />
    <!-- Referenced so the architecture tests can inspect these assemblies (layer + convention rules). -->
    <ProjectReference Include="..\..\src\Alcifra.Infrastructure\Alcifra.Infrastructure.csproj" />
    <ProjectReference Include="..\Alcifra.TestModule\Alcifra.TestModule.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.Auth\Alcifra.Auth.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.Api\Alcifra.Api.csproj" />
    <ProjectReference Include="..\..\src\Alcifra.Cli\Alcifra.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated test attestation hierarchy (ADR 0963), shared by the suites that verify attested enrolment. -->
    <Compile Include="..\Shared\TestAttestationHierarchy.cs" Link="Shared\TestAttestationHierarchy.cs" />
  </ItemGroup>

</Project>